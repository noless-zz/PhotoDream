<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the screensaver and the preview: slideshow + clock on top -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MergeRootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- no background here: the theme already paints the window black -->

    <com.noam.photodream.SlideshowView
        android:id="@+id/slideshow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.noam.photodream.PhotoTableView
        android:id="@+id/photo_table"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- night mode: dims and warms the photos (or hides them completely); not clickable, touches pass through -->
    <View
        android:id="@+id/night_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/clock_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="32dp"
        android:orientation="vertical">

        <!-- "June 2023 · 3 years ago" – only with the "Show photo date" setting -->
        <TextView
            android:id="@+id/photo_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#AA000000"
            android:shadowRadius="8"
            android:textColor="@color/overlay_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:shadowColor="#AA000000"
            android:shadowRadius="12"
            android:textColor="@color/overlay_text"
            android:textSize="64sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:shadowColor="#AA000000"
            android:shadowRadius="8"
            android:textColor="@color/overlay_text"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
