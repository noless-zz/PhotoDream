<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <!-- ===== Photos ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_photos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choose_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_folder" />

        <TextView
            android:id="@+id/txt_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_folder" />

        <!-- only visible once a phone folder is chosen -->
        <LinearLayout
            android:id="@+id/group_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_local_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/source_show" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/frame_color" />

            <com.noam.photodream.SwatchPicker
                android:id="@+id/sw_local_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_remove_folder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remove_folder" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/source_strip" />

        <!-- ===== Cloud sources (same controls for each cloud) ===== -->
        <com.noam.photodream.cloud.CloudSourceView
            android:id="@+id/source_onedrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.noam.photodream.cloud.CloudSourceView
            android:id="@+id/source_gdrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_battery"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud_battery" />

        <TextView
            android:id="@+id/txt_battery_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="@string/cloud_battery_hint" />

        <!-- ===== Display mode ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_mode" />

        <RadioGroup
            android:id="@+id/group_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
            android:minHeight="48dp"
                android:id="@+id/radio_mode_single"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_single" />

            <RadioButton
            android:minHeight="48dp"
                android:id="@+id/radio_mode_table"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_table" />
        </RadioGroup>

        <!-- ===== Slideshow (both modes) ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_slideshow" />

        <TextView
            android:id="@+id/txt_interval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <SeekBar
            android:minHeight="48dp"
            android:id="@+id/seek_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="55" />

        <!-- only for "one photo at a time" -->
        <LinearLayout
            android:id="@+id/group_single_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/transition_label" />

            <RadioGroup
                android:id="@+id/group_transition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_slide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transition_slide" />

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_fade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transition_fade" />

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_ken_burns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transition_ken_burns" />
            </RadioGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
            android:minHeight="48dp"
                android:id="@+id/sw_crop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/crop" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:minHeight="48dp"
            android:id="@+id/sw_shuffle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shuffle" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:minHeight="48dp"
            android:id="@+id/sw_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_clock" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:minHeight="48dp"
            android:id="@+id/sw_dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dim" />

        <!-- ===== Photo table (only for table mode) ===== -->
        <LinearLayout
            android:id="@+id/group_table_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_table" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/entry_label" />

            <RadioGroup
                android:id="@+id/group_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_entry_drop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/entry_drop" />

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_entry_fly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/entry_fly_in" />

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_entry_pop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/entry_pop" />

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_entry_fade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/entry_fade" />

                <RadioButton
            android:minHeight="48dp"
                    android:id="@+id/radio_entry_random"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/entry_random" />
            </RadioGroup>

            <TextView
                android:id="@+id/txt_max_cards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <SeekBar
            android:minHeight="48dp"
                android:id="@+id/seek_max_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txt_card_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <SeekBar
            android:minHeight="48dp"
                android:id="@+id/seek_card_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txt_rotation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <SeekBar
            android:minHeight="48dp"
                android:id="@+id/seek_rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
            android:minHeight="48dp"
                android:id="@+id/sw_drift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drift" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.6"
                android:text="@string/table_gestures" />
        </LinearLayout>

        <!-- ===== Run ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_system_settings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_system_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:text="@string/system_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show_intro"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/show_intro" />
    </LinearLayout>
</ScrollView>
