<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <!-- ===== Photos ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_photos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choose_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_folder" />

        <TextView
            android:id="@+id/txt_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_folder" />

        <TextView
            android:id="@+id/txt_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.6"
            android:text="@string/cloud_coming" />

        <!-- ===== Slideshow ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_slideshow" />

        <TextView
            android:id="@+id/txt_interval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/seek_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="55" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/transition_label" />

        <RadioGroup
            android:id="@+id/group_transition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radio_slide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transition_slide" />

            <RadioButton
                android:id="@+id/radio_fade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transition_fade" />

            <RadioButton
                android:id="@+id/radio_ken_burns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transition_ken_burns" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_shuffle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shuffle" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_crop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crop" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_clock" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sw_dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dim" />

        <!-- ===== Run ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_system_settings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_system_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:text="@string/system_hint" />
    </LinearLayout>
</ScrollView>
