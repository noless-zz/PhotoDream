<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <!-- time: tap to change -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_time"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="56sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/alarm_days" />

        <!-- Sunday first (the Israeli week); the group flips by itself in right-to-left languages -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/edit_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/edit_days_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/alarm_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- hidden while no challenge is implemented (registry-driven) -->
        <LinearLayout
            android:id="@+id/group_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/alarm_challenge" />

            <Spinner
                android:id="@+id/edit_challenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/alarm_difficulty" />

            <RadioGroup
                android:id="@+id/edit_difficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/diff_easy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/difficulty_easy" />

                <RadioButton
                    android:id="@+id/diff_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/difficulty_medium" />

                <RadioButton
                    android:id="@+id/diff_hard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/difficulty_hard" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/alarm_sound" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_sound"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/edit_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/alarm_vibrate" />

        <TextView
            android:id="@+id/edit_snooze_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/edit_snooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/alarm_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_test"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_test_now" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_delete" />
    </LinearLayout>
</ScrollView>
