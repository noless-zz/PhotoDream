<?xml version="1.0" encoding="utf-8"?>
<!-- The ringing screen: big clock, label, the challenge, snooze and the "can't solve it?" way out. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/alarm_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:textColor="@color/overlay_text"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/alarm_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/overlay_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/alarm_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="20sp" />

        <!-- the challenge puts its view here -->
        <FrameLayout
            android:id="@+id/alarm_challenge"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="8dp"
            android:layout_weight="1" />

        <!-- appears after 3 minutes of ringing -->
        <TextView
            android:id="@+id/alarm_fallback_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/alarm_cant_solve"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/alarm_fallback_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_type_code"
                android:textColor="@color/overlay_text" />

            <TextView
                android:id="@+id/alarm_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:textColor="@color/accent"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/alarm_code_input"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:autofillHints="creditCardSecurityCode"
                    android:gravity="center"
                    android:hint="@string/alarm_code_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:minHeight="48dp"
                    android:textColor="@color/overlay_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alarm_code_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@android:string/ok" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_snooze"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- shown for a moment after the challenge is solved -->
    <LinearLayout
        android:id="@+id/alarm_morning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_good_morning"
            android:textColor="@color/accent"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/alarm_morning_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
