    <!-- מסך פתיחה -->
    <string name="welcome_title">ברוכים הבאים ל־PhotoDream</string>
    <string name="welcome_intro">התמונות שלך כשומר מסך – בכל פעם שהטלפון בטעינה.</string>
    <string name="welcome_step1_title">1 · בוחרים תמונות</string>
    <string name="welcome_step1_text">תיקייה בטלפון, OneDrive או Google Drive – או כולם יחד. תמונות מהענן יורדות ברקע, מבחר אקראי שמתחלף כל הזמן.</string>
    <string name="welcome_step2_title">2 · מפעילים את שומר המסך</string>
    <string name="welcome_step2_text">בהגדרות שומר המסך של המערכת בוחרים ב״מצגת PhotoDream״ וקובעים שיתחיל בזמן טעינה. בסמסונג: הגדרות › תצוגה › שומר מסך. אם לא מופיע כלום, כדאי לכבות את Always On Display.</string>
    <string name="welcome_step3_title">3 · מטעינים ונהנים</string>
    <string name="welcome_step3_text">מניחים את הטלפון בטעינה ונותנים למסך לכבות. החלקה מחליפה תמונה, בשולחן התמונות אפשר לגרור אותן, הקשה כפולה על תמונה מגדילה אותה, והקשה כפולה על שולחן ריק יוצאת – מסך הנעילה נשאר מוגן.</string>
    <string name="welcome_start">מתחילים</string>
