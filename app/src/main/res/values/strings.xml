    <!-- first-run screen -->
    <string name="welcome_title">Welcome to PhotoDream</string>
    <string name="welcome_intro">Your photos as a screen saver – whenever the phone is charging.</string>
    <string name="welcome_step1_title">1 · Choose your photos</string>
    <string name="welcome_step1_text">A folder on this phone, OneDrive or Google Drive – or all of them. Cloud photos are downloaded in the background, a random selection that keeps changing.</string>
    <string name="welcome_step2_title">2 · Turn on the screen saver</string>
    <string name="welcome_step2_text">In the system screen saver settings choose \"PhotoDream slideshow\" and set it to start while charging. On Samsung: Settings › Display › Screen saver. If nothing appears, turn off Always On Display.</string>
    <string name="welcome_step3_title">3 · Charge and enjoy</string>
    <string name="welcome_step3_text">Put the phone on the charger and let the screen time out. Swipe to change photos, drag them on the photo table, double-tap a photo to enlarge it, double-tap the empty table to leave – the lock screen stays protected.</string>
    <string name="welcome_start">Let\'s start</string>
